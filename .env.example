# Optional Supabase cloud sync. Leave blank to use the built-in
# local real-time mesh (BroadcastChannel + localStorage).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional Google Gemini API key for AI intent classification.
# Leave blank to use the built-in deterministic keyword engine,
# or enter a key in the app (stored in localStorage).
VITE_GEMINI_API_KEY=
